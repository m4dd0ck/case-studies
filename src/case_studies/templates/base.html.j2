<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src 'self'">
<title>{% block title %}{{ memo.title }}{% endblock %}</title>
<style>
  :root { --bg: #fbfaf8; --panel: #fff; --text: #1d1d1f; --muted: #6b6b70; --line: #e6e3de;
    --accent: #2e5e4e; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #141415; --panel: #1c1c1e; --text: #ececed; --muted: #a0a0a6; --line: #2e2e31;
      --accent: #7cc4a8; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
    font: 16px/1.6 Georgia, "Iowan Old Style", "Times New Roman", serif; }
  main { max-width: 740px; margin: 0 auto; padding: 40px 20px 72px; }
  nav { font: 13px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  nav a { color: var(--muted); }
  .kicker { font: 600 12.5px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--accent); letter-spacing: .05em; text-transform: uppercase; margin-top: 28px; }
  h1 { font-size: 32px; line-height: 1.2; margin: 6px 0 8px; }
  .question { color: var(--muted); font-style: italic; margin: 0 0 24px; }
  h2 { font: 700 17px/1.3 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 36px 0 8px; }
  .answer { background: var(--panel); border: 1px solid var(--line);
    border-left: 4px solid var(--accent); border-radius: 8px; padding: 4px 20px; }
  .answer p { margin: 12px 0; }
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 8px;
    padding: 14px 16px; margin: 12px 0; }
  .caption { font: 13px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--muted); margin: 6px 0 0; }
  .chart { width: 100%; height: auto; font: 12px -apple-system, BlinkMacSystemFont, sans-serif; }
  .chart text { fill: var(--muted); paint-order: stroke; stroke: var(--panel); stroke-width: 4px;
    stroke-linejoin: round; }
  .chart .value { fill: var(--text); font-weight: 600; }
  .chart .axis { stroke: var(--line); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%;
    font: 13.5px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  th, td { padding: 5px 8px; border-bottom: 1px solid var(--line); text-align: right;
    white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { color: var(--muted); font-size: 11.5px; text-transform: uppercase; letter-spacing: .03em; }
  td.long { font-weight: 700; }
  ul { padding-left: 22px; } li { margin: 6px 0; }
  footer { margin-top: 44px; color: var(--muted);
    font: 12.5px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  a { color: var(--accent); }
  @media print { :root { --bg: #fff; } main { padding: 0; } .panel, .answer { break-inside: avoid; } }
</style>
</head>
<body>
<main>
  <nav><a href="index.html">All memos</a></nav>
  {% block body %}{% endblock %}
  <footer>{% block footer %}{% endblock %}</footer>
</main>
</body>
</html>
